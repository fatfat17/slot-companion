# 真實 AI 辨識（預設）
OPENAI_API_KEY=
OPENAI_MACHINE_IDENTIFICATION_MODEL=gpt-5.4-mini
# Optional server-side overrides; omitted values inherit the identification / guide model.
OPENAI_MACHINE_GUIDE_MODEL=
OPENAI_SESSION_COMPANION_MODEL=
OPENAI_SESSION_SCENE_MODEL=

# 無金鑰 UI 測試時，明確設為 mock；不要在正式環境使用。
AI_IDENTIFICATION_PROVIDER=openai
SUPABASE_URL=
# Vercel Marketplace / Supabase server-side secret key (preferred)
SUPABASE_SECRET_KEY=
# Legacy Supabase service-role key remains supported during migration
SUPABASE_SERVICE_ROLE_KEY=
CATALOG_ADMIN_TOKEN=
